PORT=8080
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=1

# Must match the Supabase project's (legacy) JWT secret
SUPABASE_JWT_SECRET=
# Forwarded to services as x-gateway-secret; also protects GET /internal/routes via x-internal-key
INTERNAL_GATEWAY_SECRET=change-me-to-a-long-random-string
# Optional: enables distributed rate limiting
REDIS_URL=redis://localhost:6379

AUTH_SERVICE_URL=http://localhost:4001
CHAT_SERVICE_URL=http://localhost:4002
ECOMMERCE_SERVICE_URL=http://localhost:4003
MEDIA_SERVICE_URL=http://localhost:4004
AI_SERVICE_URL=http://localhost:4005
