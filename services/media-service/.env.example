PORT=4004
LOG_LEVEL=INFO
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# AWS S3: leave S3_ENDPOINT_URL empty. Supabase Storage S3: https://<ref>.supabase.co/storage/v1/s3
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
S3_BUCKET=uninet-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public/CDN base URL that serves objects of the bucket (e.g. CloudFront)
MEDIA_PUBLIC_BASE_URL=
WORK_DIR=/tmp/uninet-media
MAX_UPLOAD_BYTES=4294967296
MAX_CONCURRENT_TRANSCODES=1
FFMPEG_PRESET=veryfast
