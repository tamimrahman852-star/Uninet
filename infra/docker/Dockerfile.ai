# syntax=docker/dockerfile:1.7
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY services/ai-service/requirements.txt ./
RUN pip install -r requirements.txt
COPY services/ai-service/src ./src
RUN useradd -m app
USER app
EXPOSE 4005
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
  CMD curl -fs http://127.0.0.1:4005/healthz || exit 1
CMD ["python", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "4005", "--proxy-headers", "--forwarded-allow-ips", "*", "--timeout-keep-alive", "75"]
